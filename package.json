{
  "name": "mongoose-advanced-plugin",
  "version": "0.2.0",
  "description": "Mongoose plugin: soft delete, pagination, actor tracking, embedded audit trail (auditLog), optimistic versioning + history snapshots.",
  "keywords": [
    "mongoose",
    "mongodb",
    "plugin",
    "soft-delete",
    "pagination",
    "typescript",
    "mern"
  ],
  "license": "MIT",
  "author": "Aftab Ahmad Khan (https://github.com/aftab-ahmad-khan-dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aftab-ahmad-khan-dev/mongoose-advanced-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/aftab-ahmad-khan-dev/mongoose-advanced-plugin/issues"
  },
  "homepage": "https://github.com/aftab-ahmad-khan-dev/mongoose-advanced-plugin#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --localstorage-file=.jest-localstorage ./node_modules/jest/bin/jest.js --maxWorkers=1",
    "test:watch": "node --localstorage-file=.jest-localstorage ./node_modules/jest/bin/jest.js --watch --maxWorkers=1",
    "lint": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.14.0",
    "node-fetch": "^3.3.2",
    "typescript": "^5.8.3"
  }
}
